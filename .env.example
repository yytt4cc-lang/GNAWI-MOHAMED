# ⚙️ متغيرات البيئة - Quest Completer Web v2.0

# 🌐 إعدادات الخادم
PORT=3000

# 🔐 توكن البوت على Discord (اختياري - للأصل فقط)
# DISCORD_TOKEN=your_bot_token_here

# 🆔 معرّف تطبيق Discord (اختياري - للأصل فقط)
# DISCORD_CLIENT_ID=your_application_id_here

# 📝 ملاحظات:
# - PORT: رقم المنفذ الذي سيعمل عليه الخادم (الافتراضي: 3000)
# - DISCORD_TOKEN: توكن البوت من Discord Developer Portal (اختياري للنسخة الويب)
# - DISCORD_CLIENT_ID: معرّف التطبيق من Discord Developer Portal (اختياري للنسخة الويب)
